{
  "name": "prtt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @prtt/database db:generate",
    "db:migrate": "pnpm --filter @prtt/database db:migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:deploy": "pnpm --filter @prtt/database db:deploy",
    "db:studio": "pnpm --filter @prtt/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
