{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@prtt/api",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,assets}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
