# Base locale lancée via `docker compose up -d` (port 3307).
# root est utilisé car `prisma migrate dev` doit pouvoir créer une "shadow database".
DATABASE_URL="mysql://root:root@localhost:3307/prtt"
API_PORT=3001
# Origines autorisées à appeler l'API (CORS), plusieurs possibles séparées par des virgules :
# le site du club (apps/web) et la page de connexion (apps/login, sur son propre domaine)
WEB_ORIGIN="http://localhost:3000"
LOGIN_ORIGIN="http://localhost:3002"
# Cookie de session : "lax" si site, connexion et API partagent le même domaine principal
# (ex. prtt.fr, admin.prtt.fr, api.prtt.fr) ; "none" sinon (HTTPS obligatoire)
SESSION_COOKIE_SAMESITE="lax"

# Secret de signature des cookies de session. Générer avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me"

# Dossier où est tenu à jour le fichier Excel des inscrits (un fichier par tournoi),
# relatif au dossier de lancement de l'API (apps/api).
REGISTRATIONS_DIR="storage/inscriptions"

# Stockage des images (actualités, bureau, article du tournoi), compressées en WebP :
# - sur Vercel : renseigner BLOB_READ_WRITE_TOKEN (créé automatiquement en liant un store « Blob » au projet) ;
# - en local : laisser vide, les images vont dans UPLOADS_DIR.
BLOB_READ_WRITE_TOKEN=""
# Dossier des images sur le disque (uniquement sans BLOB_READ_WRITE_TOKEN).
# Relatif au dossier de lancement de l'API (apps/api). À sauvegarder avec la base.
UPLOADS_DIR="storage/images"

# Envoi des emails de confirmation d'inscription (SMTP). Laisser SMTP_HOST vide pour désactiver l'envoi.
# Exemples : Gmail → smtp.gmail.com / 587 (mot de passe d'application) · OVH → ssl0.ovh.net / 465 · Brevo → smtp-relay.brevo.com / 587
SMTP_HOST=""
SMTP_PORT=587
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS). Vide = déduit du port.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Expéditeur affiché, ex. "PRTT Tournoi <tournoi@exemple.fr>" (vide = SMTP_USER)
MAIL_FROM=""
# Adresse de réponse si le juge-arbitre n'a pas d'email (facultatif)
MAIL_REPLY_TO=""
